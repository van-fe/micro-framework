    "@angular/platform-browser": "22.1.5",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/compiler": "22.1.5",
    "@angular/compiler-cli": "22.1.5",
    "@micro-framework/vite-plugin": "workspace:*",
    "@micro-framework/webpack-plugin": "workspace:*",
    "webpack": "5.110.3",
    "webpack-cli": "7.2.3",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "@babel/core": "8.0.1"
  }
