{
  "name": "@micro-framework/webpack-plugin",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "webpack": "^5.110.3"
  },
  "devDependencies": {
    "webpack": "5.110.3",
    "@types/node": "24.3.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@micro-framework/contracts": "workspace:*",
    "@micro-framework/realm-host": "workspace:*"
  }
}
