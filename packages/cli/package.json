{
  "name": "@micro-framework/cli",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "micro-frame": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@micro-framework/deployment-diagnostics": "workspace:*",
    "@micro-framework/migration-tools": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
