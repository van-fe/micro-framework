{
  "name": "@micro-framework/migration-tools",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@micro-framework/contracts": "workspace:*",
    "@vue/compiler-dom": "3.5.42",
    "@vue/compiler-sfc": "3.5.42",
    "postcss": "8.5.26",
    "postcss-less": "6.0.0",
    "postcss-sass": "0.5.0",
    "postcss-scss": "4.0.9",
    "postcss-styl": "0.12.3",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/postcss-less": "4.0.7",
    "vite": "8.2.2"
  }
}
