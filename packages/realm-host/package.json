  "dependencies": {
    "@micro-framework/contracts": "workspace:*",
    "@micro-framework/dom-bridge": "workspace:*",
    "@micro-framework/dom-guard": "workspace:*",
    "@micro-framework/dom-surface": "workspace:*",
    "@micro-framework/entry-resolver": "workspace:*",
    "@micro-framework/shared-resolver": "workspace:*"
  },
  "devDependencies": { "typescript": "6.0.3", "vite": "8.2.2" }
}
