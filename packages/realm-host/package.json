{
  "name": "@micro-framework/realm-host",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./realm-bootstrap": "./dist/realm-bootstrap.js"
