{
  "name": "@micro-framework/adapter-angular",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@angular/core": "^22.1.5",
    "@angular/platform-browser": "^22.1.5"
  },
  "devDependencies": {
    "@angular/core": "22.1.5",
    "@angular/common": "22.1.5",
    "@angular/platform-browser": "22.1.5",
    "rxjs": "7.8.2",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@micro-framework/contracts": "workspace:*"
  }
}
